+/*
+ * Compatibility entry point for Snow Leopard dyld/Rosetta.
+ * Lion retained the mapping machinery but retired syscall 295.
+ */
+int
+shared_region_map_np(
+	struct proc				*p,
+	struct shared_region_map_np_args	*uap,
+	__unused int				*retvalp)
+{
+	struct shared_file_mapping_np	*mappings;
+	struct shared_file_mapping_np	stack_mappings[8];
+	unsigned int			mappings_count;
+	int				error;
+
+	mappings_count = uap->count;
+	if (mappings_count == 0) {
+		return 0;
+	}
+	if (mappings_count > 8) {
+		return EINVAL;
+	}
+
+	mappings = &stack_mappings[0];
+	error = shared_region_copyin_mappings(p, uap->mappings,
+					      mappings_count, mappings);
+	if (error) {
+		return error;
+	}
+
+	return _shared_region_map(p, uap->fd, mappings_count, mappings,
+				  NULL, NULL);
+}

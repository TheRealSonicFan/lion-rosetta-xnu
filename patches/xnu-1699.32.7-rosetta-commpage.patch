+/*
+ * Store a PPC-visible, byte-swapped copy in the Rosetta compatibility
+ * area without changing Lion's native commpage contents.
+ */
+static void
+commpage_stuff_rosetta_swap(
+	commpage_address_t	address,
+	void	*source,
+	int	length )
+{
+	void *dest = commpage_addr_of(address);
+	dest = (void *)((uintptr_t) dest + _COMM_PAGE_SIGS_OFFSET);
+
+	switch (length) {
+		case 2:
+			OSWriteSwapInt16(dest, 0, *(uint16_t *)source);
+			break;
+		case 4:
+			OSWriteSwapInt32(dest, 0, *(uint32_t *)source);
+			break;
+		case 8:
+			OSWriteSwapInt64(dest, 0, *(uint64_t *)source);
+			break;
+		default:
+			panic("unsupported Rosetta commpage swap length %d", length);
+	}
